{
  "name": "pilot-prod",
  "security_mode": "production",
  "security_domain": "production",
  "orchestrator": "local",
  "dataframe_engine": "polars",
  "portable_transform_policy": "require",
  "validation_policy": "strict",
  "allow_trusted_sql": false,
  "plugin_allowlist": {
    "etlantic-polars": "==0.57.2",
    "etlantic-pandas": "==0.57.2",
    "etlantic-sql": "==0.57.2",
    "etlantic-pyspark": "==0.57.2",
    "etlantic-datafusion": "==0.57.2",
    "etlantic-airflow": "==0.57.2",
    "etlantic-prefect": "==0.57.2"
  },
  "assets": {
    "rows": "json://data/sample.json",
    "out": "json://data/out.json"
  },
  "secrets": {},
  "secret_providers": {}
}
