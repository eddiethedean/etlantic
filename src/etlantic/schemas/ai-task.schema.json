{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etlantic.dev/schemas/etlantic.ai_task/1",
  "title": "ETLantic AI task catalog",
  "type": "object",
  "required": ["schema", "tasks"],
  "properties": {
    "schema": { "const": "etlantic.ai_task/1" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "required_evidence", "approval_hook", "forbidden_actions"],
        "properties": {
          "schema": { "const": "etlantic.ai_task/1" },
          "task_id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "required_evidence": { "type": "array", "items": { "type": "string" } },
          "approval_hook": { "type": "string" },
          "forbidden_actions": { "type": "array", "items": { "type": "string" } },
          "adapters": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "forbidden_actions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
